<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- App.xaml is compiled as a Page, not ApplicationDefinition, so the
         SDK does not auto-generate a Main() for it; Program.Main (the real
         entry point) then also finds App.InitializeComponent() generated. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>LlamaDesktop</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LlamaDesktop.Core\LlamaDesktop.Core.csproj" />
    <ProjectReference Include="..\LlamaDesktop.Infrastructure\LlamaDesktop.Infrastructure.csproj" />
  </ItemGroup>
</Project>
