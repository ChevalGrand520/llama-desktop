<Window x:Class="LlamaDesktop.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LlamaDesktop.App.Presentation.Converters"
        Title="Llama Desktop" Width="1180" Height="780" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <conv:FileNameConverter x:Key="FileNameConverter"/>
  </Window.Resources>
  <Grid Margin="18,12,18,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="2,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource TextPrimaryBrush}"
              VerticalAlignment="Center" Margin="0,0,10,0">
        <Grid Margin="7">
          <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource AccentSoftBrush}" RadiusX="1" RadiusY="1"/>
          <Rectangle Height="2" VerticalAlignment="Center" Fill="{DynamicResource AccentSoftBrush}" RadiusX="1" RadiusY="1"/>
          <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource AccentSoftBrush}" RadiusX="1" RadiusY="1"/>
        </Grid>
      </Border>
      <TextBlock Grid.Column="1" Text="Llama Desktop" Style="{StaticResource WindowTitleStyle}"/>
      <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"
              Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
              BorderThickness="1" CornerRadius="12" Padding="9,4">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTextStyle}"/>
        </StackPanel>
      </Border>
      <Button Grid.Column="3" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CopyApiCommand}"
              Margin="0,0,8,0" ToolTip="复制 API 地址">
        <StackPanel Orientation="Horizontal">
          <Path Width="14" Height="14" Margin="0,0,7,0" Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M8,8 H18 V18 H8 Z M6,16 H4 A2,2 0 0 1 2,14 V4 A2,2 0 0 1 4,2 H14 A2,2 0 0 1 16,4 V6"/>
          <TextBlock Text="复制 API" VerticalAlignment="Center"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="4" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenBrowserCommand}"
              Margin="0,0,8,0" ToolTip="在浏览器中打开聊天页">
        <StackPanel Orientation="Horizontal">
          <Path Width="14" Height="14" Margin="0,0,7,0" Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M13,3 H21 V11 M21,3 L11,13 M18,13 V19 A2,2 0 0 1 16,21 H5 A2,2 0 0 1 3,19 V8 A2,2 0 0 1 5,6 H11"/>
          <TextBlock Text="打开聊天" VerticalAlignment="Center"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleSidebarCommand}"
              ToolTip="{Binding SidebarToggleToolTip}" AutomationProperties.Name="{Binding SidebarToggleToolTip}">
        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M15,3 L15,21"/>
      </Button>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="8">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.07" Color="#26312D"/></Border.Effect>
        <Grid>
          <Grid x:Name="WebHostGrid"/>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsServiceReady}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Grid Width="46" Height="42" Margin="0,0,0,14">
              <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBorderBrush}"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0"/>
              <Rectangle Width="4" Height="30" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Rectangle Width="4" Height="23" RadiusX="2" RadiusY="2" Fill="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"/>
            </Grid>
            <TextBlock Text="本地会话待机" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" x:Name="SidebarContainer" Width="320" Margin="14,0,0,0"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="16">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#26312D"/></Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="服务器" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,14"/>

          <StackPanel Grid.Row="1">
            <TextBlock Text="GGUF 模型" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,7"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ModelPicker" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                        VerticalContentAlignment="Center" ToolTip="选择要加载的 GGUF 模型">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{Binding BrowseModelCommand}"
                      Width="38" Height="38" Margin="8,0,0,0" ToolTip="浏览模型文件" AutomationProperties.Name="浏览模型文件">
                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M3,5 A2,2 0 0 1 5,3 H9 L11,5 H19 A2,2 0 0 1 21,7 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z"/>
              </Button>
            </Grid>
            <TextBlock Text="{Binding MultimodalLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="1,5,0,0"/>
          </StackPanel>

          <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleServerCommand}"
                  Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
              <Path Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                    StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M12,2 V12 M5.64,5.64 A9,9 0 1 0 18.36,5.64"/>
              <TextBlock Text="{Binding StartStopLabel}" VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
          </Button>

          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="推理参数" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Grid.Row="0">
                  <TextBlock Text="GPU 层数" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                  <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding GpuLayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="0">
                  <TextBlock Text="上下文" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                  <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding ContextSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,8,0,0">
                  <TextBlock Text="线程" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                  <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Threads, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,8,0,0">
                  <TextBlock Text="批大小" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                  <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding BatchSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </Grid>

              <Expander Header="高级参数" Margin="0,10,0,0">
                <StackPanel Margin="0,4,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Column="0" Grid.Row="0">
                      <TextBlock Text="Flash Attention" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                      <ComboBox SelectedValue="{Binding FlashAttention}" SelectedValuePath="Content">
                        <ComboBoxItem Content="on"/><ComboBoxItem Content="off"/><ComboBoxItem Content="auto"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="0">
                      <TextBlock Text="Thinking" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                      <ComboBox SelectedValue="{Binding ReasoningMode}" SelectedValuePath="Content">
                        <ComboBoxItem Content="off"/><ComboBoxItem Content="on"/><ComboBoxItem Content="auto"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,8,0,0">
                      <TextBlock Text="Fit 模式" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                      <ComboBox SelectedValue="{Binding FitMode}" SelectedValuePath="Content">
                        <ComboBoxItem Content="on"/><ComboBoxItem Content="off"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,8,0,0">
                      <TextBlock Text="并行请求" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                      <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Parallel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,8,0,0">
                      <TextBlock Text="KV 缓存 K" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                      <ComboBox SelectedValue="{Binding CacheTypeK}" SelectedValuePath="Content">
                        <ComboBoxItem Content="f16"/><ComboBoxItem Content="q8_0"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,8,0,0">
                      <TextBlock Text="KV 缓存 V" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                      <ComboBox SelectedValue="{Binding CacheTypeV}" SelectedValuePath="Content">
                        <ComboBoxItem Content="f16"/><ComboBoxItem Content="q8_0"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,8,0,0">
                      <TextBlock Text="生成上限" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                      <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding MaxPredict, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="3" Margin="1,10,0,0"
                              IsChecked="{Binding AutoSelectPort, Mode=TwoWay}" Content="端口被占用时自动顺延"/>
                    <StackPanel Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="3" Margin="0,8,0,0">
                      <TextBlock Text="额外参数" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,5"/>
                      <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding ExtraArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="API 地址" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5"/>
              <TextBlock Text="{Binding ApiBaseUrl}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CodeFont}" FontSize="11.5"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{Binding CopyApiCommand}"
                    Width="32" Height="32" Margin="8,2,0,0" ToolTip="复制 API 地址" AutomationProperties.Name="复制 API 地址">
              <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                    StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M8,8 H18 V18 H8 Z M6,16 H4 A2,2 0 0 1 2,14 V4 A2,2 0 0 1 4,2 H14 A2,2 0 0 1 16,4 V6"/>
            </Button>
          </Grid>

          <Expander Grid.Row="5" Header="实时日志" IsExpanded="{Binding IsLogDrawerOpen, Mode=TwoWay}" Margin="0,12,0,0">
            <Border Height="150" Background="{DynamicResource LogSurfaceBrush}" CornerRadius="6" ClipToBounds="True">
              <TextBox x:Name="LogText" Style="{StaticResource LogTextBoxStyle}" IsReadOnly="True" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </Border>
          </Expander>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
